DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
JWT_SECRET="dev-only-change-me"
JWT_EXPIRES_IN="30d"
GOOGLE_WEB_CLIENT_ID="same value as apps/mobile GOOGLE_WEB_CLIENT_ID"
APPLE_BUNDLE_ID="apps/mobile iOS bundle id"
PORT=3000
# Shared secret the archive-expired-events GitHub Actions workflow sends as
# the x-cron-secret header — generate any random string.
CRON_SECRET="dev-only-change-me"
# Firebase service account JSON (Project Settings > Service Accounts > Generate new private key), minified to one line
FIREBASE_SERVICE_ACCOUNT='{"project_id":"...","client_email":"...","private_key":"..."}'
FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
